    "03_CAU_CHU_CAC_TRANG/04_ABOUT_FOOD_STORIES.md": [
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.heroLead",
        "original": "Đi Phú Quốc thường phải tìm thông tin ở nhiều nơi. Open Phu Quoc gom thời tiết, đường đi, điểm đến và những điều nên biết để bạn dễ chọn hơn."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.purposeTitle",
        "original": "Thông tin du lịch thường nằm rải rác, trong khi mình lại cần quyết định khá nhanh."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.purpose1",
        "original": "Tên điểm đến mới chỉ là bắt đầu. Cần biết nơi đó có gì, nên dành bao lâu, đi lúc nào và có thể ghép với điểm nào."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.purpose2",
        "original": "Thời tiết, sân bay, tàu phà, cano và các hoạt động có thể đổi theo giờ. Vì vậy mỗi mục đều ghi lúc cập nhật và được tách khỏi phần cẩm nang ít thay đổi."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.purpose3",
        "original": "Không có thông tin không có nghĩa là mọi thứ bình thường. Dự báo vẫn là dự báo. Có chuyến trong lịch cũng chưa chắc còn vé. Nếu chưa biết, trang phải nói là chưa biết."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.systemTitle",
        "original": "Ba loại thông tin giúp bạn dễ lên kế hoạch hơn."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.system1",
        "original": "Điểm đến, món ăn, văn hóa, khách sạn và lịch trình được biên tập để bạn tìm đúng thứ mình cần."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.system2",
        "original": "Thời tiết, chuyến bay và chuyện đi lại được xem từ các nguồn riêng, luôn ghi rõ lúc nào vừa cập nhật và khi nào chưa biết chắc."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.system3",
        "original": "Open Phu Quoc đặt thông tin vào đúng bối cảnh để bạn tự cân nhắc. Một nhãn “đẹp” hay “xấu” không thể quyết định thay người đang đi."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.madeTitle",
        "original": "JoTrip làm trang này cho người đang khám phá đảo."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.madeLead1",
        "original": "Open Phu Quoc được JoTrip xây dựng từ những câu hỏi lặp lại trong công việc thật trên đảo: hôm nay biển có đi được không, chuyến bay có thay đổi không, khách ở khu này nên đi đâu, một món ăn có gì bên trong, một điểm đến có đáng chạy xuyên đảo hay không."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.madeLead2",
        "original": "Sống và làm việc trên đảo giúp tụi mình biết khách thường cần hỏi gì. Còn con số và tình hình hôm nay phải dựa trên nguồn có thời điểm rõ ràng."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.openTitle",
        "original": "“Open” nhắc tụi mình luôn nói rõ thông tin đến từ đâu, cập nhật khi nào và còn điều gì chưa chắc."
      },
      {
        "source": "data/home-copy.json",
        "pointer": "site.about.openLead",
        "original": "Với mỗi thông tin quan trọng, tụi mình ghi rõ lấy từ đâu, cập nhật khi nào và còn điều gì chưa chắc. Sau này dù có thêm ngôn ngữ hay app, nguyên tắc đó vẫn giữ nguyên."
      },
      {
