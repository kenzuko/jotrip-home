          "review_only": true
        },
        {
          "tag": "p",
          "offset": 5738,
          "original": "OPEN PHU QUOC HOẠT ĐỘNG NHƯ THẾ NÀO?",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 6119,
          "original": "Cẩm nang điểm đến",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 6453,
          "original": "Những thứ thay đổi theo giờ",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 6827,
          "original": "Để bạn tự quyết định",
          "review_only": true
        },
        {
          "tag": "p",
          "offset": 7207,
          "original": "ĐƯỢC LÀM TẠI PHÚ QUỐC",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 7962,
          "original": "Giúp ích trước, giới thiệu sau",
          "review_only": true
        },
        {
          "tag": "small",
          "offset": 8009,
          "original": "Viết để bạn có thêm cơ sở chọn lịch trình, không viết theo kiểu quảng cáo.",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 8133,
          "original": "Đúng trước, đẹp sau",
          "review_only": true
        },
        {
          "tag": "small",
          "offset": 8169,
          "original": "Không biết thì để trống, không điền một con số chỉ để giao diện trông đầy.",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 8293,
          "original": "Ưu tiên ảnh đúng địa điểm",
          "review_only": true
        },
        {
          "tag": "small",
          "offset": 8335,
          "original": "Ảnh đúng chủ thể được tách với ảnh bối cảnh, và luôn lần lại được ảnh từ đâu.",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 8462,
          "original": "Thiếu thì nói thiếu",
          "review_only": true
        },
        {
          "tag": "small",
          "offset": 8498,
          "original": "Chưa biết thì nói chưa biết; thông tin cũ thì nói là cũ.",
          "review_only": true
        },
        {
          "tag": "p",
          "offset": 8734,
          "original": "CÁCH CHÚNG TÔI KIỂM CHỨNG",
          "review_only": true
        },
        {
          "tag": "h2",
          "offset": 8792,
          "original": "Mỗi loại thông tin có một tiêu chuẩn khác nhau.",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 8973,
          "original": "Nguồn chính thức + biên tập địa phương",
          "review_only": true
        },
        {
          "tag": "p",
          "offset": 9041,
          "original": "Thông tin được xem từ cơ quan du lịch, hãng dịch vụ, tài liệu đáng tin và nguồn địa phương. Bài cũ không được dùng để khẳng định chuyện đang xảy ra hôm nay.",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 9292,
          "original": "Quan trắc, ước tính và dự báo phải tách nhau",
          "review_only": true
        },
        {
          "tag": "p",
          "offset": 9366,
          "original": "Số đo thực tế thì gọi đúng là quan trắc. Dự báo vẫn là dự báo. Nếu một nguồn không gửi về, trang không được tự hiểu thành “không mưa” hay “biển bình thường”.",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 9618,
          "original": "Cần bằng chứng đúng loại phương tiện",
          "review_only": true
        },
        {
          "tag": "p",
          "offset": 9684,
          "original": "Cano, tàu cao tốc và phà được xem riêng. Tàu chạy không có nghĩa cano chắc chắn chạy, và ngược lại.",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 9872,
          "original": "Không chắc thì không khẳng định",
          "review_only": true
        },
        {
          "tag": "p",
          "offset": 9933,
          "original": "Giá vé, lịch diễn và quyền lợi đi kèm có thể đổi theo ngày, độ tuổi, chiều cao hoặc loại vé. Mốc cũ chỉ nên dùng để dự trù, không phải giá bán được cam kết.",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 10180,
          "original": "Đúng chủ thể, đúng quyền dùng, đúng độ chính xác",
          "review_only": true
        },
        {
          "tag": "p",
          "offset": 10258,
          "original": "Ưu tiên ảnh đúng địa điểm. Ảnh chỉ mang tính bối cảnh thì phải nói rõ. Bản đồ chỉ ghim đúng một điểm khi biết chắc vị trí; chưa chắc thì chỉ khoanh khu vực.",
          "review_only": true
        },
        {
          "tag": "strong",
          "offset": 10500,
          "original": "Không chỉ kể món ngon",
          "review_only": true
        },
        {
          "tag": "p",
          "offset": 10551,
          "original": "Mỗi món cần giải thích nguồn gốc, nguyên liệu, cách ăn và thành phần có thể gây dị ứng. Công thức thay đổi theo quán nên phần an toàn luôn hướng người dùng hỏi lại nơi phục vụ.",
          "review_only": true
        },
        {
          "tag": "p",
          "offset": 10855,
          "original": "Vì sao là “Open”?",
          "review_only": true
        }
      ]
    },
