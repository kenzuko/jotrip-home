{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openpq-places-ui-hotfix",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "main": "./workers/places-ui-hotfix.js",
  "assets": {
    "directory": "./hotfix-places-assets",
    "binding": "UI_ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "openphuquoc.com/places*",
      "zone_name": "openphuquoc.com"
    }
  ]
}
