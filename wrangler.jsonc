{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openphuquoc-v3",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/stories/article.html",
      "/places/detail.html",
      "/guide/article.html",
      "/api/weather/live/feedback",
      "/api/weather/live/feedback/recent",
      "/weather/data/*",
      "/weather/spatial-ecmwf.json",
      "/weather/spatial-icon.json",
      "/weather/spatial-marine.json"
    ]
  },
  "main": "./worker.js",
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}
