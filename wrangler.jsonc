{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openphuquoc-v3",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/about",
      "/about/",
      "/about/index.html",
      "/airport",
      "/airport/",
      "/airport/index.html",
      "/bus",
      "/bus/",
      "/bus/index.html",
      "/cano",
      "/cano/",
      "/cano/index.html",
      "/currency",
      "/currency/",
      "/currency/index.html",
      "/explore",
      "/explore/",
      "/explore/index.html",
      "/ferry",
      "/ferry/",
      "/ferry/index.html",
      "/food",
      "/food/",
      "/food/index.html",
      "/food/article",
      "/food/article.html",
      "/go",
      "/go/",
      "/go/index.html",
      "/guide",
      "/guide/",
      "/guide/index.html",
      "/guide/knowledge.html",
      "/guide/article",
      "/guide/article.html",
      "/hotels",
      "/hotels/",
      "/hotels/index.html",
      "/nearme",
      "/nearme/",
      "/nearme/index.html",
      "/news",
      "/news/",
      "/news/index.html",
      "/places",
      "/places/",
      "/places/index.html",
      "/places/detail",
      "/places/detail.html",
      "/stories",
      "/stories/",
      "/stories/index.html",
      "/stories/article",
      "/stories/article.html",
      "/transit",
      "/transit/",
      "/transit/index.html",
      "/utilities",
      "/utilities/",
      "/utilities/index.html",
      "/weather",
      "/weather/",
      "/weather/index.html",
      "/en/*",
      "/en",
      "/api/feedback",
      "/api/traffic/collect",
      "/api/cms/traffic",
      "/api/ops/traffic-summary",
      "/api/cms/feedback",
      "/api/cms/feedback/photo",
      "/api/weather/live/feedback",
      "/api/weather/live/feedback/recent",
      "/api/context/v1/weather/*",
      "/api/go/live",
      "/weather/data/*",
      "/weather/spatial-ecmwf.json",
      "/weather/spatial-icon.json",
      "/weather/spatial-marine.json"
    ]
  },
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "openpq-cms",
      "database_id": "7bf38208-9fd4-4f11-ac21-320707c52517"
    }
  ],
  "main": "./worker.js",
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}
